6_Results/New_Datasets/extended_manifest.json
6_Results/New_Datasets/resolved_config.json
6_Results/New_Datasets/run_manifest.json

# Generated report bookkeeping (keep Markdown/CSV/LaTeX report sources)
docs/new_datasets/report_metadata.json

